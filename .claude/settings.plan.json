{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read"
    ],
    "deny": [
      "Bash",
      "Bash(*)",
      "PowerShell",
      "PowerShell(*)",
      "Agent(general-purpose)",
      "Edit(/**)",
      "Write(/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/auth.json)",
      "Read(**/local.yaml)",
      "Read(**/proxies.json)"
    ],
    "defaultMode": "plan"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": []
    }
  }
}
