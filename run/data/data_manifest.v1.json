{
  "schema_version": 1,
  "updated_at": "2026-07-05",
  "description": "Hextech 源码态数据目录分类清单。run/data 是唯一数据根；run/resources 不再作为真实路径存在。",
  "phase": "single-data-root",
  "rules": {
    "source_data_root": "data",
    "resources_directory_removed": true,
    "runtime_must_not_be_bundled": true,
    "raw_requires_migration": true,
    "sensitive_files_are_excluded_by_name_only": true
  },
  "categories": [
    {
      "name": "static-version",
      "resource_kind": "stable-data",
      "description": "版本级稳定 JSON/TXT 数据。Web、overlay、桌面 UI 和清洗脚本以这里作为稳定事实源。",
      "current_paths": [
        "data/static/version/"
      ],
      "source_globs": [
        "data/static/version/*.json",
        "data/static/version/*.txt"
      ],
      "target_path_for_phase_2": "data/static/version/",
      "package_role": "stable-bundle-data",
      "human_maintained": true,
      "rebuildable": "partially",
      "consumers": [
        "web",
        "overlay",
        "desktop-ui",
        "scraping-cleaners",
        "bundle-manifest"
      ],
      "notes": "Champion_Synergy_Cleaned.json 是 UI 联动真相源；raw/evidence/cache/report 不直接供 UI 消费。"
    },
    {
      "name": "static-assets",
      "resource_kind": "stable-asset",
      "description": "稳定图片和图标资源。对外 URL 可继续使用 /assets/...，底层文件来自 data/static/assets/。",
      "current_paths": [
        "data/static/assets/"
      ],
      "source_globs": [
        "data/static/assets/*.png",
        "data/static/assets/*.jpg",
        "data/static/assets/*.jpeg",
        "data/static/assets/*.webp",
        "data/static/assets/*.gif"
      ],
      "target_path_for_phase_2": "data/static/assets/",
      "package_role": "stable-bundle-assets",
      "human_maintained": true,
      "rebuildable": "partially",
      "consumers": [
        "web-assets",
        "overlay-vision",
        "icon-resolver"
      ],
      "notes": "目录内非图片文件除 README.md 外会被打包白名单拒绝。"
    },
    {
      "name": "startup-seed",
      "resource_kind": "startup-snapshot",
      "description": "构建期读取的首启 seed，用于打包产物首次启动时播种运行态数据。",
      "current_paths": [
        "data/seed/startup/"
      ],
      "source_globs": [
        "data/seed/startup/hextech/Hextech_Data_*.csv",
        "data/seed/startup/synergy/Champion_Synergy_*.json"
      ],
      "target_path_for_phase_2": "data/seed/startup/",
      "package_role": "bundle-startup-seed",
      "human_maintained": false,
      "rebuildable": "yes",
      "consumers": [
        "bundle-manifest",
        "runtime-bundle",
        "packaged-startup-smoke"
      ],
      "notes": "seed 是冷启动输入，不是运行中 UI 真相源；运行后数据写入 data/runtime/raw。"
    },
    {
      "name": "source-evidence",
      "resource_kind": "source-evidence",
      "description": "用于复现 cleaned 数据的外部来源证据，例如 ARAMMayhem raw。",
      "current_paths": [
        "data/evidence/"
      ],
      "source_globs": [
        "data/evidence/*.json"
      ],
      "target_path_for_phase_2": "data/evidence/",
      "package_role": "build-input-not-ui-source",
      "human_maintained": true,
      "rebuildable": "yes",
      "consumers": [
        "data-cleaners",
        "audit-tools"
      ],
      "notes": "来源证据不直接供 Web/API 或 overlay 读取；更新后必须重新生成 static/version cleaned 数据。"
    },
    {
      "name": "diagnostic-fixtures",
      "resource_kind": "diagnostic-fixture",
      "description": "离线视觉匹配和诊断回归样例。",
      "current_paths": [
        "data/fixtures/diagnostics/"
      ],
      "source_globs": [
        "data/fixtures/diagnostics/overlay_vision_fixtures/**/*.png",
        "data/fixtures/diagnostics/overlay_matching_truth.v1.json"
      ],
      "target_path_for_phase_2": "data/fixtures/diagnostics/",
      "package_role": "offline-check-fixture",
      "human_maintained": true,
      "rebuildable": "no",
      "consumers": [
        "overlay-eval",
        "diagnostic-tests"
      ],
      "notes": "真实运行诊断输出写入 data/runtime/debug/**，不得混入 fixture。"
    },
    {
      "name": "runtime",
      "resource_kind": "mutable-runtime",
      "description": "本机运行态 raw/state/cache/logs/reports/debug/profile/locks/persisted。",
      "current_paths": [
        "data/runtime/"
      ],
      "source_globs": [
        "data/runtime/**"
      ],
      "target_path_for_phase_2": "data/runtime/",
      "package_role": "forbidden",
      "human_maintained": false,
      "rebuildable": "yes",
      "consumers": [
        "running-app",
        "scrapers",
        "diagnostics"
      ],
      "allow_empty": true,
      "notes": "运行态默认 ignored，禁止进入包，也不得作为 stable/static 事实源。"
    }
  ]
}
