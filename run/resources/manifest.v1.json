{
  "schema_version": 1,
  "updated_at": "2026-07-16",
  "description": "Hextech 不可变资源与运行态边界清单。resources 随源码和包分发，var 只保存可变运行态。",
  "rules": {
    "resource_root": "resources",
    "runtime_root": "var",
    "runtime_must_not_be_bundled": true,
    "ui_reads_generation_only": true,
    "source_runs_publish_through_data_service": true
  },
  "categories": [
    {
      "name": "catalog",
      "resource_kind": "stable-catalog",
      "path": "resources/catalog/",
      "source_globs": ["resources/catalog/*.json", "resources/catalog/*.txt"],
      "package_role": "stable-bundle-data",
      "consumers": ["data-service", "scrapers", "web", "overlay"]
    },
    {
      "name": "assets",
      "resource_kind": "stable-asset",
      "path": "resources/assets/",
      "source_globs": [
        "resources/assets/**/*.png",
        "resources/assets/**/*.jpg",
        "resources/assets/**/*.jpeg",
        "resources/assets/**/*.webp",
        "resources/assets/**/*.gif"
      ],
      "package_role": "stable-bundle-assets",
      "consumers": ["web", "overlay", "vision"]
    },
    {
      "name": "seeds",
      "resource_kind": "verified-generation-seed",
      "path": "resources/seeds/",
      "source_globs": [
        "resources/seeds/current.v1.json",
        "resources/seeds/generations/*/*"
      ],
      "package_role": "bundle-startup-seed",
      "consumers": ["data-service", "runtime-bundle", "packaged-startup-smoke"]
    },
    {
      "name": "mayhem-evidence",
      "resource_kind": "source-evidence",
      "path": "resources/evidence/mayhem/",
      "source_globs": ["resources/evidence/mayhem/*.json"],
      "allow_empty": true,
      "package_role": "build-input-not-ui-source",
      "consumers": ["mayhem-parser", "audit-tools"]
    },
    {
      "name": "diagnostic-fixtures",
      "resource_kind": "test-fixture",
      "path": "tests/fixtures/diagnostics/",
      "source_globs": ["tests/fixtures/diagnostics/**/*"],
      "package_role": "forbidden",
      "consumers": ["vision-tests", "diagnostic-tools"]
    },
    {
      "name": "runtime",
      "resource_kind": "mutable-runtime",
      "path": "var/",
      "source_globs": ["var/**"],
      "package_role": "forbidden",
      "consumers": ["data-service", "desktop", "web", "overlay", "scrapers"]
    }
  ]
}
